{
    "name": "ROS2 Dev Env",
    "build": {
        "dockerfile": "Dockerfile",
        "args": {
            "USERNAME": "ros"
        }
    },
    "runArgs": [
        "--network=host",
        "--privileged",
        // IPC host mode for Qt/GTK shared memory (fixes SHM errors)
        "--ipc=host",
        // Windows GPU/NPU Universal Connector
        "--device=/dev/dxg",
        "--device=/dev/dri",
        "-e",
        "DISPLAY=${env:DISPLAY}"
    ],
    "workspaceMount": "source=${localWorkspaceFolder},target=/home/ros/env,type=bind",
    "workspaceFolder": "/home/ros/ros_ws",
    "mounts": [
        // Mount workspace from local folder (Visible in WSL)
        "source=${localWorkspaceFolder}/../ros_ws,target=/home/ros/ros_ws,type=bind",
        // Mount ccache volume for build performance
        "source=ros2_ccache,target=/home/ros/.ccache,type=volume",
        // Mount X11 socket for GUI (WSLg support)
        "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind",
        // CRITICAL: Mount Windows Host Driver Store for WSL2 hardware projection
        "source=/usr/lib/wsl/lib,target=/usr/lib/wsl/lib,type=bind",
        // WSLg Wayland/Audio support (enhanced GUI compatibility)
        "source=/mnt/wslg,target=/mnt/wslg,type=bind,readonly"
    ],
    "containerEnv": {
        // Display settings
        "DISPLAY": ":0",
        // WSL2 Driver path
        "LD_LIBRARY_PATH": "/usr/lib/wsl/lib:${env:LD_LIBRARY_PATH}",
        // GPU Rendering: Use D3D12 driver for WSL2
        "LIBGL_ALWAYS_INDIRECT": "0",
        "MESA_LOADER_DRIVER_OVERRIDE": "d3d12",
        "GALLIUM_DRIVER": "d3d12",
        // Default GPU adapter (Intel for laptop compatibility)
        "MESA_D3D12_DEFAULT_ADAPTER_NAME": "Intel",
        // WSLg Wayland/Audio integration
        "XDG_RUNTIME_DIR": "/mnt/wslg/runtime-dir",
        "WAYLAND_DISPLAY": "wayland-0",
        "PULSE_SERVER": "/mnt/wslg/PulseServer",
        // Qt compatibility
        "QT_X11_NO_MITSHM": "1"
    },
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.profiles.linux": {
                    "bash": {
                        "path": "/bin/bash",
                        "icon": "terminal-bash"
                    }
                },
                "terminal.integrated.defaultProfile.linux": "bash"
            },
            "extensions": [
                "ms-vscode.cpptools-extension-pack",
                "Ranch-Hand-Robotics.rde-pack",
                "ms-python.python",
                "yzhang.markdown-all-in-one",
                "mhutchie.git-graph",
                "eamodio.gitlens"
            ]
        }
    },
    "postCreateCommand": "bash /home/ros/env/scripts/init_workspace.sh",
    "remoteUser": "ros"
}