{
    "name": "ROS2 Gazebo Universal",
    "build": {
        "dockerfile": "Dockerfile",
        "args": {
            "USERNAME": "ros"
        }
    },
    // Pre-container device detection (cross-platform compatibility)
    "initializeCommand": "bash ${localWorkspaceFolder}/.devcontainer/scripts/detect_devices.sh || true",
    "runArgs": [
        // 1. Network, IPC (ROS2)
        "--net=host",
        "--ipc=host",
        "--pid=host",
        // 2. security, permission
        "--security-opt=seccomp:unconfined",
        "--security-opt=apparmor:unconfined",
        // 3. Device Mapping (GPU/NPU via D3D12 passthrough)
        "--device=/dev/dxg",
        "--device=/dev/dri",
        // 4. Environment Variables
        "-e",
        "DISPLAY=${env:DISPLAY}",
        "-e",
        "WAYLAND_DISPLAY=${env:WAYLAND_DISPLAY}",
        "-e",
        "PULSE_SERVER=${env:PULSE_SERVER}",
        "-e",
        "XDG_RUNTIME_DIR=/mnt/wslg/runtime-dir",
    ],
    "containerEnv": {
        // NVIDIA Container Runtime
        "NVIDIA_VISIBLE_DEVICES": "all",
        "NVIDIA_DRIVER_CAPABILITIES": "all",
        // Mesa/OpenGL (driver auto-detected by gpu_setup.sh)
        "LIBGL_ALWAYS_SOFTWARE": "0",
        "QT_X11_NO_MITSHM": "1"
    },
    "workspaceMount": "source=${localWorkspaceFolder},target=/home/ros/env,type=bind",
    "workspaceFolder": "/home/ros/ros_ws",
    "mounts": [
        // Mount workspace from local folder (Visible in WSL)
        "source=${localWorkspaceFolder}/../ros_ws,target=/home/ros/ros_ws,type=bind",
        // Mount ccache volume for build performance
        "source=ros2_ccache,target=/home/ros/.ccache,type=volume",
        // Mount X11 socket for GUI (WSLg support)
        "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind",
        // CRITICAL: Mount Windows Host Driver Store for WSL2 hardware projection
        "source=/usr/lib/wsl/lib,target=/usr/lib/wsl/lib,type=bind",
        // WSLg Wayland/Audio support (enhanced GUI compatibility)
        "source=/mnt/wslg,target=/mnt/wslg,type=bind,readonly"
    ],
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.profiles.linux": {
                    "bash": {
                        "path": "/bin/bash",
                        "icon": "terminal-bash"
                    }
                },
                "terminal.integrated.defaultProfile.linux": "bash"
            },
            "extensions": [
                "ms-vscode.cpptools-extension-pack",
                "Ranch-Hand-Robotics.rde-pack",
                "ms-python.python",
                "yzhang.markdown-all-in-one",
                "mhutchie.git-graph",
                "eamodio.gitlens"
            ]
        }
    },
    "postCreateCommand": "bash /home/ros/env/scripts/init_workspace.sh",
    "postStartCommand": "source /home/ros/env/scripts/gpu_setup.sh auto 2>/dev/null || true",
    "remoteUser": "ros"
}